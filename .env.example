# Discord Bot Token — https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
LOG_CHANNEL_ID=

# Tiered thresholds — higher = fewer false positives
# High confidence ≥ THRESHOLD → auto-block (delete + timeout)
NSFW_THRESHOLD=0.85
GORE_THRESHOLD=0.85
# Medium confidence ≥ REVIEW_THRESHOLD but < THRESHOLD → review queue (kept, sent to mod-log)
NSFW_REVIEW_THRESHOLD=0.75
GORE_REVIEW_THRESHOLD=0.75
# Gender filter — very conservative, off by default
BLOCK_GENDER_IMAGES=false
GENDER_THRESHOLD=0.90

BLOCK_INVITES=true
BLOCKED_DOMAINS=
ALLOWED_DOMAINS=discord.com,github.com,gitlab.com
DELETE_MESSAGE=true
SEND_WARNING=true
TIMEOUT_DURATION_SECONDS=300
ALLOW_IN_NSFW_CHANNELS=false
SKIP_TINY_IMAGES=true
ENABLE_REVIEW_QUEUE=true
NSFW_MODEL_PATH=./models/nsfw_detector.onnx
GORE_MODEL_PATH=./models/gore_detector.onnx
DATABASE_PATH=./data/rosy.db
RUST_LOG=info,rosy=debug
