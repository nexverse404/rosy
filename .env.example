# Discord Bot Token — https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Moderation log channel ID (right-click channel → Copy ID with Developer Mode)
LOG_CHANNEL_ID=

# Detection thresholds (0.0 - 1.0) — global defaults, override per-guild via /rosy config
NSFW_THRESHOLD=0.75
GORE_THRESHOLD=0.75

# Gender-specific image filtering (opt-in, policy-driven, off by default)
BLOCK_GENDER_IMAGES=false

# Link filtering — global defaults
BLOCK_INVITES=true
BLOCKED_DOMAINS=
ALLOWED_DOMAINS=discord.com,github.com,gitlab.com

# Bot behavior — global defaults
DELETE_MESSAGE=true
SEND_WARNING=true
TIMEOUT_DURATION_SECONDS=300
# Allow flagged content in NSFW-marked channels (global default for new guilds)
ALLOW_IN_NSFW_CHANNELS=false

# Model paths (optional, for onnx feature)
NSFW_MODEL_PATH=./models/nsfw_detector.onnx
GORE_MODEL_PATH=./models/gore_detector.onnx

# Persistence
DATABASE_PATH=./data/rosy.db

# Rust log
RUST_LOG=info,rosy=debug
