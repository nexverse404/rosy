# Discord Bot Token — https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Moderation log channel ID (right-click channel → Copy ID with Developer Mode)
LOG_CHANNEL_ID=

# Detection thresholds (0.0 - 1.0)
NSFW_THRESHOLD=0.75
GORE_THRESHOLD=0.75

# Gender-specific image filtering (opt-in, policy-driven)
BLOCK_GENDER_IMAGES=false

# Link filtering
BLOCK_INVITES=true
BLOCKED_DOMAINS=
ALLOWED_DOMAINS=discord.com,github.com,gitlab.com

# Bot behavior
DELETE_MESSAGE=true
SEND_WARNING=true
TIMEOUT_DURATION_SECONDS=300

# Model paths (optional, for onnx feature)
NSFW_MODEL_PATH=./models/nsfw_detector.onnx
GORE_MODEL_PATH=./models/gore_detector.onnx

# Rust log
RUST_LOG=info,rosy=debug
